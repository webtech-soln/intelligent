# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 ("I'm not a robot" checkbox)
# Create a key pair at https://www.google.com/recaptcha/admin
# Choose "Challenge (v2)" -> "I'm not a robot" tickbox.
# Add localhost and itechsolutions.us to the allowed domains.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Where contact enquiries are delivered
# ---------------------------------------------------------------------------
# Must be an address on a domain verified with your email provider.
CONTACT_FROM_EMAIL="Intelligent Tech Solutions <website@itechsolutions.us>"
# Optional — defaults to info@itechsolutions.us
CONTACT_TO_EMAIL=info@itechsolutions.us

# ---------------------------------------------------------------------------
# Email transport — set ONE of the two blocks below.
# Resend wins if both are present.
# ---------------------------------------------------------------------------

# Option A: Resend (https://resend.com) — verify itechsolutions.us as a domain
RESEND_API_KEY=

# Option B: SMTP, e.g. Google Workspace, Microsoft 365 or cPanel mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
